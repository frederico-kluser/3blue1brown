# OpenRouter Configuration
OPENROUTER_API_KEY=sk-or-v1-sua-chave-aqui
OPENROUTER_MODEL=deepseek/deepseek-v4-pro
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# App Configuration
APP_NAME="Manim Video Generator API"
DEBUG=false

# Manim Configuration
RENDER_TIMEOUT=120
DEFAULT_FPS=30

# Renderizador usado pelo Manim: "auto" (detecta GPU e decide), "cairo" (força CPU), "opengl" (força GPU)
MANIM_RENDERER=auto

# Se true, quando o render OpenGL falhar (selecionado via "auto" ou "opengl"), tenta novamente com Cairo
MANIM_RENDERER_FALLBACK=true

# Server
HOST=0.0.0.0
PORT=8000
